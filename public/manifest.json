{
  "manifest_version": 3,
  "name": "draob",
  "version": "0.1.0",
  "description": "Board-Passwörter verschlüsselt speichern, durchsuchen und mit einem Klick auf Miro-Boards einfügen. Alles lokal, ohne Konto.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    },
    "default_title": "draob"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.miro.com/app/board/*"
      ],
      "js": [
        "content.bundle.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "minimum_chrome_version": "110"
}
