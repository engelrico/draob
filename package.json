{
  "name": "draob-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension (MV3) for managing passwords of Miro boards.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint --ext .js,.jsx src tests",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\"",
    "test": "jest",
    "licenses": "node scripts/check-licenses.js",
    "version": "node scripts/sync-manifest-version.js && git add public/manifest.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.0"
  }
}
