{
  "name": "draob-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension (MV3) for managing passwords of Miro boards.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "lint": "eslint --ext .js,.jsx src tests",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\"",
    "test": "jest",
    "licenses": "node scripts/check-licenses.js",
    "version": "node scripts/sync-manifest-version.js && git add public/manifest.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.2.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
