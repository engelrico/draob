{
    "manifest_version": 3,
    "name": "MiroHero",
    "version": "0.1",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icons/MH_icon.png"
    },
    "icons": {
        "48": "icons/MH_icon.png"
    },
    "content_scripts": [
        {
            "matches": ["*://*.miro.com/app/board/*"],
            "js": ["content.js"]
        }
    ]
    ,
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    }
}
